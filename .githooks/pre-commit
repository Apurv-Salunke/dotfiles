#!/usr/bin/env bash
# Block commits that contain secrets. Bypass (if you're sure): git commit --no-verify
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not installed (brew install gitleaks), skipping secret scan" >&2
  exit 0
fi
exec gitleaks git --staged --no-banner --redact -v
